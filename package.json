{
  "name": "sp-dashboard-financeiro",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "check": "npm run lint && npm run build && npm audit",
    "audit:auth": "node scripts/audit-firestore-auth.mjs",
    "audit:auth:with-export": "node scripts/audit-firestore-auth.mjs --export-auth",
    "audit:auth:cleanup": "node scripts/audit-firestore-auth.mjs --export-auth --cleanup-legacy-password-fields",
    "auth:update-recovery-emails": "node scripts/update-recovery-emails.mjs",
    "auth:update-recovery-emails:apply": "node scripts/update-recovery-emails.mjs --apply",
    "backup:firestore": "node scripts/export-firestore-data.mjs",
    "audit:transactions": "node scripts/audit-transactions-data.mjs",
    "normalize:transactions": "node scripts/normalize-transactions-data.mjs",
    "quarantine:transactions": "node scripts/quarantine-invalid-transactions.mjs",
    "deactivate:users": "node scripts/deactivate-users.mjs",
    "transfer:auth-email": "node scripts/transfer-auth-email.mjs",
    "maintenance:precheck": "node scripts/pre-maintenance-check.mjs",
    "deploy:hosting": "npm run build && firebase deploy --only hosting --project gen-lang-client-0888019226",
    "deploy:rules": "firebase deploy --only firestore:rules --project gen-lang-client-0888019226",
    "deploy:rules:dry-run": "firebase deploy --only firestore:rules --dry-run --project gen-lang-client-0888019226",
    "deploy:all": "npm run build && firebase deploy --only hosting,firestore:rules --project gen-lang-client-0888019226"
  },
  "dependencies": {
    "@google/genai": "0.14.1",
    "firebase": "^12.10.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "0.344.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router": "^6.30.3",
    "react-router-dom": "^6.30.3",
    "recharts": "2.12.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^22.14.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
