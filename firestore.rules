rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return hasProfile() && profile().data.active == true;
    }

    function isAdmin() {
      return isActiveUser() && profile().data.role == 'admin';
    }

    function isMaster() {
      return isAdmin() && request.auth.uid == 'hpdsWehGGAYE3uKCar4pBiRVxFJ3';
    }

    function isPendingSelfRegistration(userId) {
      return signedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'username',
          'name',
          'email',
          'phone',
          'role',
          'active',
          'status',
          'createdAt',
          'createdVia',
          'authUid',
          'authEmail',
          'authProvider'
        ])
        && request.resource.data.role == 'operacional'
        && request.resource.data.active == false
        && request.resource.data.status == 'pending'
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.authEmail == request.auth.token.email
        && request.resource.data.authProvider == 'firebase'
        && request.resource.data.createdVia in ['dashboard', 'self-registration'];
    }

    // Baixas usam o servidor, que registra auditoria na mesma transação.
    function isAdministrativeExclusion() {
      return isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isExcluded', 'exclusionReason', 'excludedAt', 'excludedBy', 'excludedByName', 'updatedAt'
        ])
        && request.resource.data.isExcluded == true
        && request.resource.data.exclusionReason is string
        && request.resource.data.exclusionReason.size() > 0;
    }

    match /users/{userId} {
      allow get: if isAdmin() || (signedIn() && userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isAdmin() || isPendingSelfRegistration(userId);
      allow update: if isAdmin()
        && (userId != 'hpdsWehGGAYE3uKCar4pBiRVxFJ3' || (isMaster()
          && request.resource.data.role == 'admin' && request.resource.data.active == true))
        && (request.resource.data.role == resource.data.role
          || (isMaster() && userId != request.auth.uid
            && resource.data.role == 'admin' && request.resource.data.role == 'operacional'
            && request.resource.data.financialPermissions == []
            && request.resource.data.demotedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'role', 'financialPermissions', 'demotedBy', 'demotedAt', 'updatedAt'
            ])))
        && resource.data.get('status', '') != 'deleted'
        && (request.resource.data.get('status', '') != 'deleted'
          || (userId != request.auth.uid
            && resource.data.role == 'operacional'
            && request.resource.data.active == false
            && request.resource.data.financialPermissions == []
            && request.resource.data.deletedBy == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'active', 'status', 'financialPermissions', 'deletedAt', 'deletedBy', 'updatedAt'
            ])));
      allow delete: if false;
    }

    match /loginIndex/{username} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdmin();
    }

    match /transactions/{transactionId} {
      allow read: if isActiveUser();
      allow create: if isAdmin();
      allow update: if isAdministrativeExclusion();
      allow delete: if isAdmin();
    }

    match /clientRegistry/{entryId} {
      allow read: if isActiveUser();
      allow create, update, delete: if isAdmin();
    }

    match /billingProfiles/{profileId} {
      allow read: if isActiveUser();
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // Conferências independentes: não dão permissão para modificar transações.
    function validReviewBase(d) {
      return d.schemaVersion == 1 && d.revision is int && d.revision > 0
        && d.actorUid == request.auth.uid && d.updatedAt == request.time
        && d.auditId is string && d.auditId.size() == 20
        && d.evidence is string && d.evidence.size() > 0 && d.evidence.size() <= 4000;
    }
    function stableBillingIdentity(value) {
      return value is string && value.matches('^(doc:[0-9]{11}|doc:[0-9]{14}|number:[0-9]+)$');
    }
    function reviewDate(value) {
      return value is string && (value == '' || value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
    }
    function validMonthlyReview(d) {
      return validReviewBase(d) && d.keys().hasOnly([
        'schemaVersion','revision','auditId','actorUid','createdAt','updatedAt',
        'month','identity','client','decision','amount','dueDate','startDate',
        'billingDay','lastChargeDate','evidence','event','sourceFingerprint'
      ]) && d.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && stableBillingIdentity(d.identity) && d.client is string && d.client.size() > 0
        && d.sourceFingerprint.matches('^[a-f0-9]{64}$')
        && d.decision in ['needs_review','charge']
        && d.event in ['entrada','saida','alteracao','suspensao','recorrencia','pendente','multiplos']
        && (d.amount == null || (d.amount is number && d.amount > 0))
        && d.billingDay is int && d.billingDay >= 0 && d.billingDay <= 31
        && reviewDate(d.dueDate) && reviewDate(d.startDate) && reviewDate(d.lastChargeDate)
        && (d.decision == 'needs_review' || (isAdmin() && d.amount is number && d.amount > 0
          && d.dueDate != '' && d.startDate != '' && d.billingDay > 0
          && !(d.event in ['pendente','multiplos'])
          && (!(d.event in ['saida','suspensao']) || d.lastChargeDate != '')));
    }
    match /billingMonthlyReviews/{reviewId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser() && validMonthlyReview(request.resource.data)
        && reviewId == request.resource.data.month + '_' + request.resource.data.identity
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/billingMonthlyReviews/$(reviewId)/revisions/$(request.resource.data.auditId)).data == request.resource.data;
      allow update: if isActiveUser() && validMonthlyReview(request.resource.data)
        && (isAdmin() || resource.data.decision == 'needs_review')
        && request.resource.data.identity == resource.data.identity
        && request.resource.data.month == resource.data.month
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.auditId != resource.data.auditId
        && getAfter(/databases/$(database)/documents/billingMonthlyReviews/$(reviewId)/revisions/$(request.resource.data.auditId)).data == request.resource.data;
      allow delete: if false;
      match /revisions/{revisionId} {
        allow read: if isActiveUser();
        allow create: if isActiveUser()
          && request.resource.data.updatedAt == request.time
          && request.resource.data.auditId == revisionId
          && getAfter(/databases/$(database)/documents/billingMonthlyReviews/$(reviewId)).data == request.resource.data;
        allow update, delete: if false;
      }
    }
    function validIdentityLink(d) {
      return validReviewBase(d) && d.keys().hasOnly([
        'schemaVersion','revision','auditId','actorUid','createdAt','updatedAt',
        'sourceIdentity','targetIdentity','evidence'
      ]) && d.sourceIdentity.matches('^(unidentified|checklist-unidentified):.+$')
        && stableBillingIdentity(d.targetIdentity);
    }
    match /billingIdentityLinks/{linkId} {
      allow read: if isActiveUser();
      allow create: if isAdmin() && validIdentityLink(request.resource.data)
        && request.resource.data.createdAt == request.time && request.resource.data.revision == 1
        && getAfter(/databases/$(database)/documents/billingIdentityLinks/$(linkId)/revisions/$(request.resource.data.auditId)).data == request.resource.data;
      allow update: if isAdmin() && validIdentityLink(request.resource.data)
        && request.resource.data.sourceIdentity == resource.data.sourceIdentity
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1
        && request.resource.data.auditId != resource.data.auditId
        && getAfter(/databases/$(database)/documents/billingIdentityLinks/$(linkId)/revisions/$(request.resource.data.auditId)).data == request.resource.data;
      allow delete: if false;
      match /revisions/{revisionId} {
        allow read: if isActiveUser();
        allow create: if isAdmin() && request.resource.data.updatedAt == request.time
          && request.resource.data.auditId == revisionId
          && getAfter(/databases/$(database)/documents/billingIdentityLinks/$(linkId)).data == request.resource.data;
        allow update, delete: if false;
      }
    }

    // Acompanhamento operacional: coleção nova, sem permissões financeiras adicionais.
    function followUpActive(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.active == true
        && !(get(/databases/$(database)/documents/users/$(uid)).data.get('status', '') in ['deleted','blocked']);
    }
    function followUpReader() { return signedIn() && followUpActive(request.auth.uid); }
    function followUpName(uid) {
      let user = get(/databases/$(database)/documents/users/$(uid)).data;
      return user.get('name', '') != '' ? user.name : (user.get('username', '') != '' ? user.username : uid);
    }
    function followUpDate(value) {
      return value is string && (value.matches('^[0-9]{4}-((0[13578]|1[02])-(0[1-9]|[12][0-9]|3[01])|(0[469]|11)-(0[1-9]|[12][0-9]|30)|02-(0[1-9]|1[0-9]|2[0-8]))$')
        || value.matches('^([0-9]{2}(0[48]|[2468][048]|[13579][26])|([02468][048]|[13579][26])00)-02-29$'));
    }
    function validFollowUp(d) {
      return validReviewBase(d) && d.keys().hasOnly([
        'schemaVersion','revision','auditId','actorUid','createdAt','updatedAt',
        'month','identity','client','assigneeUid','assigneeName','deadline','state','evidence'
      ]) && d.month.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && d.identity.matches('^(doc:[0-9]{11}|doc:[0-9]{14}|number:[0-9]+|(unidentified|checklist-unidentified):[^/]+)$')
        && d.client is string && d.client.size() > 0 && d.client.size() <= 300
        && d.assigneeUid is string && d.assigneeUid.size() > 0 && !d.assigneeUid.matches('.*[/].*')
        && followUpActive(d.assigneeUid)
        && d.assigneeName is string && d.assigneeName.size() > 0 && d.assigneeName.size() <= 300
        && d.assigneeName == followUpName(d.assigneeUid)
        && d.state in ['open','done'] && followUpDate(d.deadline);
    }
    match /billingFollowUps/{taskId} {
      allow read: if followUpReader();
      allow create: if followUpReader() && isAdmin() && validFollowUp(request.resource.data)
        && taskId == request.resource.data.month + '_' + request.resource.data.identity
        && request.resource.data.revision == 1 && request.resource.data.createdAt == request.time
        && getAfter(/databases/$(database)/documents/billingFollowUps/$(taskId)/revisions/$(request.resource.data.auditId)).data == request.resource.data;
      allow update: if followUpReader() && isAdmin() && validFollowUp(request.resource.data)
        && request.resource.data.month == resource.data.month && request.resource.data.identity == resource.data.identity
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.auditId != resource.data.auditId
        && getAfter(/databases/$(database)/documents/billingFollowUps/$(taskId)/revisions/$(request.resource.data.auditId)).data == request.resource.data;
      allow delete: if false;
      match /revisions/{revisionId} {
        allow read: if followUpReader();
        allow create: if followUpReader() && isAdmin() && request.resource.data.updatedAt == request.time
          && request.resource.data.auditId == revisionId
          && getAfter(/databases/$(database)/documents/billingFollowUps/$(taskId)).data == request.resource.data;
        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
